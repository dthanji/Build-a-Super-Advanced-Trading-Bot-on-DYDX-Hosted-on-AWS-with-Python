# Safe defaults: the bot starts in paper/dry-run mode.
BOT_ENV=paper
DRY_RUN=true
DYDX_NETWORK=testnet
DYDX_SUBACCOUNT_NUMBER=0
DYDX_ADDRESS=
POLL_SECONDS=15
CANDLE_RESOLUTION=1HOUR
LOOKBACK_CANDLES=500
MIN_OBSERVATIONS=200

# Primary momentum strategy defaults
MOMENTUM_FAST_EMA=20
MOMENTUM_SLOW_EMA=50
MOMENTUM_TREND_FAST_EMA=20
MOMENTUM_TREND_SLOW_EMA=50
MOMENTUM_BREAKOUT_WINDOW=20
MOMENTUM_ATR_WINDOW=14
MOMENTUM_VOLUME_WINDOW=20
MOMENTUM_VOLUME_MULTIPLIER=1.10
MOMENTUM_STOP_ATR=2.0
MOMENTUM_TRAIL_ATR=2.5
MOMENTUM_RISK_FRACTION=0.01
MOMENTUM_FEE_BPS=5
MOMENTUM_SLIPPAGE_BPS=2

# Legacy cointegration baseline parameters retained for research comparison
COINT_PVALUE=0.05
ZSCORE_ENTRY=1.5
ZSCORE_EXIT=0.5
MAX_HALF_LIFE=24

MAX_TRADE_USD=100
MAX_GROSS_USD=500
MAX_PAIRS=3
MAX_DAILY_LOSS_USD=25
MAX_HOLDING_HOURS=24

# Inject through AWS Secrets Manager / runtime environment; never commit values.
DYDX_MNEMONIC=
DYDX_PRIVATE_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

[Unit]
Description=dYdX statistical arbitrage bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dydx-bot
EnvironmentFile=/etc/dydx-bot.env
ExecStart=/opt/dydx-bot/.venv/bin/python /opt/dydx-bot/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dydx-bot/data

[Install]
WantedBy=multi-user.target
